Complexity:-
Time complexity:
O(nlogn)
radix sort: O(nlog64 ​M) where M=max(nums)

Space complexity:-
O(∣sort∣)
0 <= nums[i] <= 105

Code:-
class Solution {
    public int minimumDifference(int[] nums, int k) {
        int n = nums.length;
        Arrays.sort(nums);
        int ans = nums[k - 1] - nums[0];
        for (int i = 0; i + k <= n; i++) {
            ans = Math.min(ans, nums[i + k - 1] - nums[i]);
        }
        return ans;
    }
}
