import java.util.*;

public class MatrixQueries {
    public static int[][] applyQueries(int n, int[][] queries) {
        // Step 1: Initialize difference matrix
        int[][] diff = new int[n + 1][n + 1];

        // Step 2: Apply difference updates
        for (int[] q : queries) {
            int r1 = q[0], c1 = q[1], r2 = q[2], c2 = q[3];
            diff[r1][c1] += 1;
            diff[r1][c2 + 1] -= 1;
            diff[r2 + 1][c1] -= 1;
            diff[r2 + 1][c2 + 1] += 1;
        }

        // Step 3: Build final matrix using prefix sums
        int[][] mat = new int[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int val = diff[i][j];
                if (i > 0) val += mat[i - 1][j];
                if (j > 0) val += mat[i][j - 1];
                if (i > 0 && j > 0) val -= mat[i - 1][j - 1];
                mat[i][j] = val;
            }
        }

        return mat;
    }

    // Utility to print matrix
    public static void printMatrix(int[][] mat) {
        for (int[] row : mat) {
            System.out.println(Arrays.toString(row));
        }
    }

    public static void main(String[] args) {
        int n1 = 3;
        int[][] queries1 = {{1,1,2,2},{0,0,1,1}};
        int[][] result1 = applyQueries(n1, queries1);
        printMatrix(result1);
        // Expected: [[1,1,0],[1,2,1],[0,1,1]]

        System.out.println();

        int n2 = 2;
        int[][] queries2 = {{0,0,1,1}};
        int[][] result2 = applyQueries(n2, queries2);
        printMatrix(result2);
        // Expected: [[1,1],[1,1]]
    }
}
